{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "hastalavistamoney",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "changelog-sections": [
        { "type": "feat", "section": "✨ Новые возможности" },
        { "type": "fix", "section": "🐛 Исправления" },
        { "type": "perf", "section": "⚡ Производительность" },
        { "type": "refactor", "section": "♻️ Рефакторинг" },
        { "type": "docs", "section": "📚 Документация" },
        { "type": "test", "section": "🧪 Тесты", "hidden": true },
        { "type": "ci", "section": "🔧 CI/CD", "hidden": true },
        { "type": "chore", "section": "🧹 Прочее", "hidden": true }
      ],
      "extra-files": [
        {
          "type": "generic",
          "path": "hasta_la_vista_money/__init__.py"
        },
        {
          "type": "generic",
          "path": ".bumpversion.cfg"
        },
        {
          "type": "generic",
          "path": "setup.py"
        },
        {
          "type": "toml",
          "path": "pyproject.toml",
          "jsonpath": "$.tool.bumpversion.current_version"
        }
      ]
    }
  }
}
